SHELL = /bin/sh
.SUFFIXES: .cc .o

LULESH_EXEC = lulesh.0

PRECISION ?= SINGLE

ifeq ($(PRECISION),SINGLE)
PRECISION_FLAG = -DPRECISION_MODE=1
else ifeq ($(PRECISION),DOUBLE)
PRECISION_FLAG = -DPRECISION_MODE=2
else ifeq ($(PRECISION),MIXED)
PRECISION_FLAG = -DPRECISION_MODE=3
else
$(error PRECISION must be SINGLE, MIXED, or DOUBLE)
endif

CXX = clang++ -DUSE_MPI=0

SOURCES2.0 = \
	lulesh.cc \
	lulesh-comm.cc \
	lulesh-viz.cc \
	lulesh-util.cc \
	lulesh-init.cc
OBJECTS2.0 = $(SOURCES2.0:.cc=.o)

# Native builds disable the tutorial injection block copied with this source.
CXXFLAGS = -g -O2 -I. -Wall  $(PRECISION_FLAG)
LDFLAGS = -g -O2

#Below are reasonable default flags for a serial build
#CXXFLAGS = -g -O3 -I. -Wall
#LDFLAGS = -g -O3 

#common places you might find silo on the Livermore machines.
#SILO_INCDIR = /opt/local/include
#SILO_LIBDIR = /opt/local/lib
#SILO_INCDIR = ./silo/4.9/1.8.10.1/include
#SILO_LIBDIR = ./silo/4.9/1.8.10.1/lib

#If you do not have silo and visit you can get them at:
#silo:  https://wci.llnl.gov/codes/silo/downloads.html
#visit: https://wci.llnl.gov/codes/visit/download.html

#below is and example of how to make with silo, hdf5 to get vizulization by default all this is turned off.  All paths are Livermore specific.
#CXXFLAGS = -g -DVIZ_MESH -I${SILO_INCDIR} -Wall -Wno-pragmas
#LDFLAGS = -g -L${SILO_LIBDIR} -Wl,-rpath -Wl,${SILO_LIBDIR} -lsiloh5 -lhdf5

.cc.o: lulesh.h
	@echo "Building $<"
	CCACHE_DISABLE=1 $(CXX) -c $(CXXFLAGS) -o $@  $<

all: $(LULESH_EXEC)

$(LULESH_EXEC): $(OBJECTS2.0)
	@echo "Linking"
	CCACHE_DISABLE=1 $(CXX) $(OBJECTS2.0) $(LDFLAGS) -lm -o $@

clean:
	/bin/rm -f *.o *~ $(OBJECTS) $(LULESH_EXEC)
	/bin/rm -rf *.dSYM
	/bin/rm -rf .fpc_logs

tar: clean
	cd .. ; tar cvf lulesh-2.0.tar LULESH-2.0 ; mv lulesh-2.0.tar LULESH-2.0
